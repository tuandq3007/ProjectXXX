1002:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c ****   *         @arg COMP_OUTPUT_LEVEL_HIGH
1003:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c ****   *
1004:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c ****   */
