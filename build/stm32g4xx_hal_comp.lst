 174:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** 
 175:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Delay for COMP startup time.                                               */
 176:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Note: Delay required to reach propagation delay specification.             */
 177:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Literal set to maximum value (refer to device datasheet,                   */
 178:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* parameter "tSTART").                                                       */
 179:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Unit: us                                                                   */
 180:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** #define COMP_DELAY_STARTUP_US           (5UL)      /*!< Delay for COMP startup time */
